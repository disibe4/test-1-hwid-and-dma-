function Invoke-PrefetchScan {
    $reg = (Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters' -ErrorAction SilentlyContinue).EnablePrefetcher
    if ($reg -eq 0) {
        Add-Finding 'Prefetch Disabled' 'Prefetch is turned off - execution traces are not being recorded (possible evidence tampering)' 'HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters' 'Medium'
    }
    $files = @(Get-ChildItem "$env:SystemRoot\Prefetch\*.pf" -Force -ErrorAction SilentlyContinue)
    if ($files.Count -eq 0) {
        Add-Finding 'Prefetch Empty' 'No Prefetch files present - folder may have been wiped' "$env:SystemRoot\Prefetch" 'Medium'
        return
    }
    $hits = 0
    foreach ($f in $files) {
        $exe = $f.Name -replace '-[0-9A-Fa-f]{8}\.pf$', ''
        if ($exe -match $StrongRx) {
            Add-Finding 'Prefetch Execution Trace' "$exe was executed (last run $($f.LastWriteTime.ToString('yyyy-MM-dd HH:mm')))" $f.FullName 'High'; $hits++
        } elseif ($exe -match $WeakRx) {
            Add-Finding 'Prefetch Execution Trace' "$exe (known executor name) was executed (last run $($f.LastWriteTime.ToString('yyyy-MM-dd HH:mm')))" $f.FullName 'Medium'; $hits++
        }
    }
    if ($hits -eq 0) { Add-Pass "Prefetch clean ($($files.Count) traces reviewed)" }
}

function Invoke-DefenderScan {
    try {
        $st = Get-MpComputerStatus -ErrorAction Stop
        if ($st.RealTimeProtectionEnabled) { Add-Pass 'Defender real-time protection ON' }
        else { Add-Finding 'Defender Real-Time OFF' 'Windows Defender real-time protection is DISABLED' 'Windows Security > Virus & threat protection' 'High' }
        if (-not $st.AntivirusEnabled) { Add-Finding 'Defender Antivirus OFF' 'Windows Defender antivirus engine is disabled' 'Windows Security > Virus & threat protection' 'Medium' }
        $pref = Get-MpPreference -ErrorAction Stop
        $ex = 0
        foreach ($x in @($pref.ExclusionPath))      { if ($x) { Add-Finding 'Defender Path Exclusion' 'Folder/file excluded from Defender scanning' $x 'High'; $ex++ } }
        foreach ($x in @($pref.ExclusionProcess))   { if ($x) { Add-Finding 'Defender Process Exclusion' 'Process excluded from Defender scanning' $x 'High'; $ex++ } }
        foreach ($x in @($pref.ExclusionExtension)) { if ($x) { Add-Finding 'Defender Extension Exclusion' "Extension '$x' excluded from Defender scanning" 'Windows Defender exclusion list' 'Medium'; $ex++ } }
        if ($ex -eq 0) { Add-Pass 'No Defender exclusions' }
    } catch {
        Add-Finding 'Defender Unavailable' 'Could not query Windows Defender (disabled, removed, or replaced by another AV)' 'Get-MpComputerStatus' 'Info'
    }
}


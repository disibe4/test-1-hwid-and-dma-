
    
  
}

function Esc-Md([string]$s) { if ($null -eq $s) { return '' }; return ($s -replace '([\\*_~`|>])', '\$1') }
function Cut([string]$s, [int]$max) { if ($s.Length -gt $max) { return $s.Substring(0, $max - 3) + '...' } else { return $s } }
function New-UserBlock([string]$id) {
    if ($id) { return "<@$id>`n[$(($ProfileBase -replace '^https?://', ''))$id]($ProfileBase$id)" }
    return '`Not provided`'
}
function New-SuspectBlock([string]$id) {
    if ($id) { return "[$RobloxProfileBase$id]($RobloxProfileBase$id)" }
    return '`Not provided`'
}

function Send-Report {
    param([string]$TierName, [string]$SuspectId, [string]$ModId, [TimeSpan]$Elapsed)
    if ([string]::IsNullOrWhiteSpace($WebhookUrl)) {
        Write-Host '  Discord reporting skipped because no webhook was provided.' -ForegroundColor DarkYellow
        return $false
    }
    $sorted = @($Script:Findings | Sort-Object @{ e = { switch ($_.Severity) { 'High' { 0 } 'Medium' { 1 } default { 2 } } } }, Category)
    $high = @($sorted | Where-Object { $_.Severity -eq 'High' }).Count
    $med  = @($sorted | Where-Object { $_.Severity -eq 'Medium' }).Count
    $info = @($sorted | Where-Object { $_.Severity -eq 'Info' }).Count

    if ($high -gt 0)     { $color = 15548997; $head = '### :rotating_light:  SUSPICIOUS ACTIVITY DETECTED'; $verdict = 'FLAGGED' }
    elseif ($med -gt 0)  { $color = 16705372; $head = '### :warning:  REVIEW NEEDED';                       $verdict = 'REVIEW' }
    else                 { $color = 5763719;  $head = '### :white_check_mark:  NO DETECTIONS';              $verdict = 'CLEAN' }

    $ts   = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ss.000Z')
    $unix = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds()
    $passed = if ($Script:Passed.Count) { '```diff' + "`n" + (($Script:Passed | ForEach-Object { "+ $_" }) -join "`n") + "`n" + '```' } else { '`none`' }

    $fields = @(
        @{ name = ':dart: Suspected Roblox Player'; value = (New-SuspectBlock $SuspectId); inline = $true },
        @{ name = ':shield: Moderator'; value = (New-UserBlock $ModId);   inline = $true },
        @{ name = ':bar_chart: Verdict'; value = "``$verdict``  |  :red_circle: $high  :yellow_circle: $med  :white_circle: $info"; inline = $true },
        @{ name = ':gear: Scan Tier'; value = "``$TierName``"; inline = $true },
        @{ name = ':computer: Machine'; value = "``$env:COMPUTERNAME`` / ``$env:USERNAME``"; inline = $true },
        @{ name = ':stopwatch: Completed'; value = "<t:${unix}:R>  (took $([int]$Elapsed.TotalSeconds)s)"; inline = $true },
        @{ name = ':white_check_mark: Passed Checks'; value = (Cut $passed 1000); inline = $false }
    )
    $headerEmbed = @{
        title = 'ARSENAL COMPETITIVE | SCAN REPORT'
        description = "$head`n$($Script:Findings.Count) finding(s) recorded on **$env:COMPUTERNAME**"
        color = $color; fields = $fields; timestamp = $ts
        footer = @{ text = "$ToolName v3.0  |  Windows $([Environment]::OSVersion.Version)" }
    }
    $ok = Send-DiscordPayload @{ username = $ToolName; allowed_mentions = @{ parse = @() }; embeds = @($headerEmbed) }
    if (-not $ok) { return $false }
    Start-Sleep -Milliseconds 700

    if ($sorted.Count -eq 0) { return $true }
    $chunks = New-Object System.Collections.Generic.List[object]
    $cur = New-Object System.Text.StringBuilder; $curSev = 'Info'
    $rank = @{ High = 0; Medium = 1; Info = 2 }
    foreach ($f in $sorted) {
        $entry = '**[' + (Esc-Md $f.Category) + ']** ' + (Esc-Md (Cut $f.Details 300)) + "`n" + '*Path:* ' + (Esc-Md (Cut $f.Path 350))
        if ($cur.Length + $entry.Length + 2 -gt 3700) {
            $chunks.Add(@{ Text = $cur.ToString(); Sev = $curSev }); $cur = New-Object System.Text.StringBuilder; $curSev = 'Info'
        }
        if ($cur.Length -gt 0) { [void]$cur.Append("`n`n") }
        [void]$cur.Append($entry)
        if ($rank[$f.Severity] -lt $rank[$curSev]) { $curSev = $f.Severity }
    }
    if ($cur.Length -gt 0) { $chunks.Add(@{ Text = $cur.ToString(); Sev = $curSev }) }

    $total = $chunks.Count; $i = 0
    foreach ($ch in $chunks) {
        $i++
        $col = switch ($ch.Sev) { 'High' { 15548997 } 'Medium' { 16705372 } default { 9807270 } }
        $desc = $ch.Text
        if ($i -eq $total -and $chunks.Count -gt 10) { $desc += "`n`n*...additional detections truncated (Discord limit).*" }
        $emb = @{ title = "DETECTIONS  |  Part $i of $total"; description = $desc; color = $col; footer = @{ text = "$ToolName  |  Suspect: $(if ($SuspectId) { $SuspectId } else { 'n/a' })  |  Mod: $(if ($ModId) { $ModId } else { 'n/a' })" } }
        [void](Send-DiscordPayload @{ username = $ToolName; allowed_mentions = @{ parse = @() }; embeds = @($emb) })
        Start-Sleep -Milliseconds 700
    }
    return $true
}

Show-Banner
Write-Host '  This tool scans this PC and sends the results to the moderation team.' -ForegroundColor DarkGray
$consent = (Read-Host '  Does the owner of this PC consent to this scan? (Y/N)').Trim()
if ($consent -notmatch '^(y|yes)$') { Write-Host '  Scan cancelled.' -ForegroundColor DarkYellow; Start-Sleep 2; exit }
Write-Host ''

Show-Menu
$tier = 0
while ($tier -lt 1 -or $tier -gt 3) {
    $t = (Read-Host '  Choose tier (1-3)').Trim()
    if ($t -match '^[1-3]$') { $tier = [int]$t } else { Write-Host '    Enter 1, 2 or 3.' -ForegroundColor DarkYellow }
}
Write-Host ''
$SuspectId = Read-RobloxId '  Roblox user ID of the suspected player (ENTER to skip)'
$ModId     = Read-DiscordId '  Discord ID of the moderator running the test (ENTER to skip)'
$TierName  = @('', 'Tier 1 - Standard', 'Tier 2 - Deep', 'Tier 3 - Full Forensic')[$tier]
Write-Host ''
Write-Host "  >> $TierName armed. Starting scan..." -ForegroundColor Cyan
Write-Host ''

$steps = @(
    @{ N = 'Processes + renamed executables';     T = 1; A = { Invoke-ProcessScan } },
    @{ N = 'Roblox module injection check';       T = 1; A = { Invoke-RobloxModuleScan } },
    @{ N = 'Cheat files on disk';                 T = 1; A = { Invoke-DiskScan } },
    @{ N = 'Prefetch execution traces';           T = 2; A = { Invoke-PrefetchScan } },
    @{ N = 'Defender status + exclusions';        T = 2; A = { Invoke-DefenderScan } },
    @{ N = 'Memory Integrity / VBS';              T = 3; A = { Invoke-VbsScan } },
    @{ N = 'DMA / FPGA hardware';                 T = 3; A = { Invoke-DmaScan } }
)
$active = @($steps | Where-Object { $_.T -le $tier })
$sw = [Diagnostics.Stopwatch]::StartNew()
$n = 0
foreach ($s in $active) {
    $n++
    $before = $Script:Findings.Count
    Show-Step $n $active.Count $s.N
    try { & $s.A } catch {}
    $delta = $Script:Findings.Count - $before
    if ($delta -gt 0) { Write-Host "  -> +$delta" -ForegroundColor Red } else { Write-Host '  -> ok' -ForegroundColor Green }
}
$sw.Stop()

Write-Host ''
Write-Host '  ==================== RESULTS ====================' -ForegroundColor Cyan
if ($Script:Findings.Count -eq 0) {
    Write-Host '  No detections.' -ForegroundColor Green
} else {
    foreach ($f in ($Script:Findings | Sort-Object @{ e = { switch ($_.Severity) { 'High' { 0 } 'Medium' { 1 } default { 2 } } } }, Category)) {
        $c = switch ($f.Severity) { 'High' { 'Red' } 'Medium' { 'Yellow' } default { 'DarkGray' } }
        Write-Host ("  [{0}] " -f $f.Category) -ForegroundColor $c -NoNewline
        Write-Host $f.Details -ForegroundColor White
        Write-Host ("      Path: {0}" -f $f.Path) -ForegroundColor DarkGray
    }
}
foreach ($p in $Script:Passed) { Write-Host "  [+] $p" -ForegroundColor DarkGreen }
Write-Host ''

$WebhookUrl = (Read-Host '  Discord webhook URL (leave blank to skip reporting)').Trim()
if ($WebhookUrl) {
    Write-Host '  Sending report to Discord...' -ForegroundColor Cyan -NoNewline
    $sent = Send-Report -TierName $TierName -SuspectId $SuspectId -ModId $ModId -Elapsed $sw.Elapsed
    if ($sent) { Write-Host '  delivered.' -ForegroundColor Green } else { Write-Host '  FAILED (check internet / webhook).' -ForegroundColor Red }
} else {
    Write-Host '  Discord reporting skipped.' -ForegroundColor DarkYellow
}
Write-Host ''
Read-Host '  Press ENTER to exit' | Out-Null


function Test-SystemPath([string]$p) {
    if (-not $p) { return $true }
    if ($p.StartsWith("$env:SystemRoot\Temp\", [StringComparison]::OrdinalIgnoreCase)) { return $false }
    foreach ($r in $SysRoots) { if ($p.StartsWith($r + '\', [StringComparison]::OrdinalIgnoreCase)) { return $true } }
    return $false
}
function Get-VerInfo([string]$p) { try { [Diagnostics.FileVersionInfo]::GetVersionInfo($p) } catch { $null } }
function Get-SigStatus([string]$p) {
    if ($SigCache.ContainsKey($p)) { return $SigCache[$p] }
    $s = 'Unknown'
    try { $s = (Get-AuthenticodeSignature -LiteralPath $p -ErrorAction Stop).Status.ToString() } catch {}
    $SigCache[$p] = $s
    return $s
}

    foreach ($u in (Get-ChildItem "$env:SystemDrive\Users" -Directory -Force | Where-Object { $_.Name -notin 'Public', 'Default', 'Default User', 'All Users' })) {
        foreach ($s in @(@('Desktop', 4), @('Downloads', 4), @('Documents', 3), @('AppData\Local\Temp', 3), @('AppData\Roaming', 2), @('AppData\Local', 2))) {

function Invoke-ProcessScan {
    $lolbins = '^(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32)\.exe$'
    foreach ($p in (Get-CimInstance Win32_Process)) {
        if ($p.ProcessId -in 0, 4, $PID) { continue }
        $name = [string]$p.Name; $path = [string]$p.ExecutablePath; $cmd = [string]$p.CommandLine
        if ($TrustedApps -contains ($name -replace '\.exe$', '')) { continue }

        if (Test-SystemPath $path) {
            if ($name -match $lolbins -and $cmd -match $StrongRx -and $cmd -notmatch 'CompetitiveAntiExploit') {
                Add-Finding 'Suspicious Command Line' "$name (PID $($p.ProcessId)) command line references an exploit signature" $path 'High'
            }
            continue
        }

        $vi = Get-VerInfo $path
        $meta = "$($vi.OriginalFilename) $($vi.InternalName) $($vi.ProductName) $($vi.FileDescription) $($vi.CompanyName)"
        if ($name -match $StrongRx -or $path -match $StrongRx) {
            Add-Finding 'Cheat Process' "$name (PID $($p.ProcessId)) matches a known exploit/cheat signature" $path 'High'
        }
        elseif ($meta -match $StrongRx) {
            Add-Finding 'Renamed Executable' "$name is disguised - embedded metadata reveals '$($vi.OriginalFilename)' / '$($vi.ProductName)'" $path 'High'
        }
        elseif ($name -match $WeakRx -and (Get-SigStatus $path) -ne 'Valid') {
            Add-Finding 'Suspicious Process' "$name (PID $($p.ProcessId)) is unsigned and uses a known executor name" $path 'Medium'
        }
        if ($cmd -match $StrongRx -and $name -notmatch $StrongRx -and $cmd -notmatch 'CompetitiveAntiExploit') {
            Add-Finding 'Suspicious Command Line' "$name (PID $($p.ProcessId)) launched with exploit-related arguments" $path 'Medium'
        }
    }
}


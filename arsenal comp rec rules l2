function Read-SharedText([string]$Path) {
    try {
        $fs = [IO.File]::Open($Path, 'Open', 'Read', 'ReadWrite')
        try {
            if ($fs.Length -gt 40MB) { return '' }
            $buf = New-Object byte[] $fs.Length
            [void]$fs.Read($buf, 0, $buf.Length)
            return [Text.Encoding]::GetEncoding(28591).GetString($buf)
        } finally { $fs.Dispose() }
    } catch { return '' }
}

function Invoke-DiscordScan {
    param([string]$SuspectId)
    $acc = @{}
    $rxCache  = [regex]'user_id_cache[^0-9]{0,24}(\d{17,20})'
    $rxUser   = [regex]'\\?"id\\?"\s*:\s*\\?"(\d{17,20})\\?"\s*,\s*\\?"username\\?"\s*:\s*\\?"([^"\\]{2,32})'
    $rxSentry = [regex]'"user"\s*:\s*\{[^}]*?"id"\s*:\s*"(\d{17,20})"'
    $clients  = @('discord', 'discordptb', 'discordcanary', 'discorddevelopment', 'Lightcord', 'vesktop', 'vesktop\sessionData', 'legcord', 'ArmCord')

    $add = {
        param($id, $name, $client, $prof, $file)
        if (-not $acc.ContainsKey($id)) {
            $acc[$id] = [pscustomobject]@{ Id = $id; Name = ''; Client = $client; Profile = $prof; Path = $file }
        }
        if ($name -and -not $acc[$id].Name) { $acc[$id].Name = $name }
    }

    foreach ($u in (Get-ChildItem "$env:SystemDrive\Users" -Directory -Force | Where-Object { $_.Name -notin 'Public', 'Default', 'Default User', 'All Users' })) {
        $roam = Join-Path $u.FullName 'AppData\Roaming'
        foreach ($c in $clients) {
            $base = Join-Path $roam $c
            if (-not (Test-Path -LiteralPath $base)) { continue }
            $files = @()
            $ldb = Join-Path $base 'Local Storage\leveldb'
            if (Test-Path -LiteralPath $ldb) { $files += @(Get-ChildItem "$ldb\*" -Include '*.ldb', '*.log' -File -Force) }
            $sent = Join-Path $base 'sentry\scope_v3.json'
            if (Test-Path -LiteralPath $sent) { $files += @(Get-Item -LiteralPath $sent -Force) }
            foreach ($f in $files) {
                $text = Read-SharedText $f.FullName
                if (-not $text) { continue }
                foreach ($m in $rxCache.Matches($text))  { & $add $m.Groups[1].Value '' $c $u.Name $f.FullName }
                foreach ($m in $rxUser.Matches($text))   { & $add $m.Groups[1].Value $m.Groups[2].Value $c $u.Name $f.FullName }
                foreach ($m in $rxSentry.Matches($text)) { & $add $m.Groups[1].Value '' $c $u.Name $f.FullName }
            }
        }
    }
    $Script:DiscordAccounts = @($acc.Values)

    $Script:WinAccounts = @(Get-CimInstance Win32_UserProfile -ErrorAction SilentlyContinue | Where-Object { -not $_.Special -and $_.LocalPath } | ForEach-Object {
        $n = Split-Path $_.LocalPath -Leaf
        if ($_.LastUseTime) { "$n (last used $($_.LastUseTime.ToString('yyyy-MM-dd')))" } else { $n }
    })

    foreach ($a in $Script:DiscordAccounts) {
        if ($SuspectId -and $a.Id -ne $SuspectId) {
            $nm = if ($a.Name) { "$($a.Name) " } else { '' }
            Add-Finding 'Discord Alt Account' "Additional Discord account ${nm}($($a.Id)) found on this device via $($a.Client) / Windows user $($a.Profile)" $a.Path 'Medium'
        }
    }
    if ($SuspectId -and $Script:DiscordAccounts.Count -gt 0 -and -not ($Script:DiscordAccounts | Where-Object { $_.Id -eq $SuspectId })) {
        Add-Finding 'Discord ID Mismatch' "Suspect ID $SuspectId was NOT found in any local Discord client data (different or alt account in use?)" 'Local Discord client storage' 'Medium'
    }
    if ($Script:DiscordAccounts.Count -eq 0) { Add-Pass 'No Discord client data found on this device' }
    elseif ($Script:DiscordAccounts.Count -eq 1 -and $SuspectId -and $Script:DiscordAccounts[0].Id -eq $SuspectId) { Add-Pass 'Only the suspect Discord account found on this device' }
}


function Show-DecryptText([string]$Text, [ConsoleColor]$Color = 'Cyan', [int]$Frames = 16) {
    $rnd = New-Object Random
    $chars = '#$%&@!?*+=<>/|0123456789ABCDEF'.ToCharArray()
    for ($f = 0; $f -le $Frames; $f++) {
        $sb = New-Object Text.StringBuilder
        foreach ($c in $Text.ToCharArray()) {
            if ($c -eq ' ' -or $rnd.NextDouble() -lt ($f / $Frames)) { [void]$sb.Append($c) }
            else { [void]$sb.Append($chars[$rnd.Next($chars.Length)]) }
        }
        $col = if ($f -eq $Frames) { $Color } else { 'DarkGray' }
        Write-Host ("`r" + $sb.ToString()) -NoNewline -ForegroundColor $col
        Start-Sleep -Milliseconds 40
    }
    Write-Host ''
}

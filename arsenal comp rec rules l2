function Send-DiscordPayload {
    param([hashtable]$Payload)
    $json  = $Payload | ConvertTo-Json -Depth 12 -Compress
    $bytes = [Text.Encoding]::UTF8.GetBytes($json)
    for ($try = 1; $try -le 3; $try++) {
        try {
            Invoke-RestMethod -Uri $WebhookUrl -Method Post -ContentType 'application/json; charset=utf-8' -Body $bytes -UserAgent $UserAgent -TimeoutSec 20 -ErrorAction Stop | Out-Null
            return $true
        } catch {
            $code = 0; try { $code = [int]$_.Exception.Response.StatusCode } catch {}
            if ($code -eq 429) { Start-Sleep -Seconds 3; continue }
            try {
                $req = [Net.HttpWebRequest]::Create($WebhookUrl)
                $req.Method = 'POST'; $req.ContentType = 'application/json; charset=utf-8'
                $req.UserAgent = $UserAgent; $req.Timeout = 20000; $req.ContentLength = $bytes.Length
                $rs = $req.GetRequestStream(); $rs.Write($bytes, 0, $bytes.Length); $rs.Close()
                $resp = $req.GetResponse(); $resp.Close()
                return $true
            } catch {
                $c2 = 0; try { $c2 = [int]$_.Exception.Response.StatusCode } catch {}
                if ($c2 -eq 429) { Start-Sleep -Seconds 3 } else { Start-Sleep -Seconds 2 }
            }
        }
    }
    return $false
}


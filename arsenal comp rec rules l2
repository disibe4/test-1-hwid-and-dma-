function Cut([string]$s, [int]$max) { if ($s.Length -gt $max) { return $s.Substring(0, $max - 3) + '...' } else { return $s } }
function New-UserBlock([string]$id) {
    if ($id) { return "<@$id>`n[$(($ProfileBase -replace '^https?://', ''))$id]($ProfileBase$id)" }
    return '`Not provided`'
}

function Send-Report {
    param([string]$TierName, [string]$SuspectId, [string]$ModId, [TimeSpan]$Elapsed)
    $sorted = @($Script:Findings | Sort-Object @{ e = { switch ($_.Severity) { 'High' { 0 } 'Medium' { 1 } default { 2 } } } }, Category)
    $high = @($sorted | Where-Object { $_.Severity -eq 'High' }).Count
    $med  = @($sorted | Where-Object { $_.Severity -eq 'Medium' }).Count
    $info = @($sorted | Where-Object { $_.Severity -eq 'Info' }).Count

    if ($high -gt 0)     { $color = 15548997; $head = '### :rotating_light:  SUSPICIOUS ACTIVITY DETECTED'; $verdict = 'FLAGGED' }
    elseif ($med -gt 0)  { $color = 16705372; $head = '### :warning:  REVIEW NEEDED';                       $verdict = 'REVIEW' }
    else                 { $color = 5763719;  $head = '### :white_check_mark:  NO DETECTIONS';              $verdict = 'CLEAN' }

    $ts   = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ss.000Z')
    $unix = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds()
    $passed = if ($Script:Passed.Count) { '```diff' + "`n" + (($Script:Passed | ForEach-Object { "+ $_" }) -join "`n") + "`n" + '```' } else { '`none`' }

    $fields = @(
        @{ name = ':dart: Suspect';   value = (New-UserBlock $SuspectId); inline = $true },
        @{ name = ':shield: Moderator'; value = (New-UserBlock $ModId);   inline = $true },
        @{ name = ':bar_chart: Verdict'; value = "``$verdict``  |  :red_circle: $high  :yellow_circle: $med  :white_circle: $info"; inline = $true },
        @{ name = ':gear: Scan Tier'; value = "``$TierName``"; inline = $true },
        @{ name = ':computer: Machine'; value = "``$env:COMPUTERNAME`` / ``$env:USERNAME``"; inline = $true },
        @{ name = ':stopwatch: Completed'; value = "<t:${unix}:R>  (took $([int]$Elapsed.TotalSeconds)s)"; inline = $true },
        @{ name = ':white_check_mark: Passed Checks'; value = (Cut $passed 1000); inline = $false }
    )
    $headerEmbed = @{
        title = 'COMPETITIVE ANTI-EXPLOIT  |  SCAN REPORT'
        description = "$head`n$($Script:Findings.Count) finding(s) recorded on **$env:COMPUTERNAME**"
        color = $color; fields = $fields; timestamp = $ts
        footer = @{ text = "$ToolName v3.0  |  Windows $([Environment]::OSVersion.Version)" }
    }
    $ok = Send-DiscordPayload @{ username = $ToolName; allowed_mentions = @{ parse = @() }; embeds = @($headerEmbed) }
    if (-not $ok) { return $false }
    Start-Sleep -Milliseconds 700

    # Discord accounts embed
    $accLines = New-Object System.Collections.Generic.List[string]
    foreach ($a in ($Script:DiscordAccounts | Select-Object -First 25)) {
        $flag = if (-not $SuspectId) { ':grey_question:' } elseif ($a.Id -eq $SuspectId) { ':green_circle: suspect' } else { ':orange_circle: alt candidate' }
        $nm = if ($a.Name) { Esc-Md $a.Name } else { 'unknown name' }
        $accLines.Add("$flag  **$nm**  <@$($a.Id)>  [profile]($ProfileBase$($a.Id))`n*Client:* $($a.Client)  |  *Windows user:* $(Esc-Md $a.Profile)")
    }
    $accDesc = if ($accLines.Count) { ($accLines -join "`n`n") } else { 'No Discord accounts were found in local client data.' }
    $winDesc = if ($Script:WinAccounts.Count) { (($Script:WinAccounts | Select-Object -First 15 | ForEach-Object { '`' + $_ + '`' }) -join '  ') } else { '`none`' }
    $accEmbed = @{
        title = ':busts_in_silhouette:  DISCORD ACCOUNT / ALT DETECTOR'
        description = (Cut $accDesc 3600)
        color = 5793266
        fields = @(@{ name = ':desktop: Windows accounts on this device'; value = (Cut $winDesc 1000); inline = $false })
        footer = @{ text = 'Best-effort: reads IDs cached by installed Discord clients. No tokens are read.' }
    }
    [void](Send-DiscordPayload @{ username = $ToolName; allowed_mentions = @{ parse = @() }; embeds = @($accEmbed) })
    Start-Sleep -Milliseconds 700

    # Detection embeds
    if ($sorted.Count -eq 0) { return $true }
    $chunks = New-Object System.Collections.Generic.List[object]
    $cur = New-Object System.Text.StringBuilder; $curSev = 'Info'
    $rank = @{ High = 0; Medium = 1; Info = 2 }
    foreach ($f in $sorted) {
        $entry = '**[' + (Esc-Md $f.Category) + ']** ' + (Esc-Md (Cut $f.Details 300)) + "`n" + '*Path:* ' + (Esc-Md (Cut $f.Path 350))
        if ($cur.Length + $entry.Length + 2 -gt 3700) {
            $chunks.Add(@{ Text = $cur.ToString(); Sev = $curSev }); $cur = New-Object System.Text.StringBuilder; $curSev = 'Info'
        }
        if ($cur.Length -gt 0) { [void]$cur.Append("`n`n") }
        [void]$cur.Append($entry)
        if ($rank[$f.Severity] -lt $rank[$curSev]) { $curSev = $f.Severity }
    }
    if ($cur.Length -gt 0) { $chunks.Add(@{ Text = $cur.ToString(); Sev = $curSev }) }

    $total = [math]::Min($chunks.Count, 10); $i = 0
    foreach ($ch in ($chunks | Select-Object -First 10)) {
        $i++
        $col = switch ($ch.Sev) { 'High' { 15548997 } 'Medium' { 16705372 } default { 9807270 } }
        $desc = $ch.Text
        if ($i -eq $total -and $chunks.Count -gt 10) { $desc += "`n`n*...additional detections truncated (Discord limit).*" }
        $emb = @{ title = "DETECTIONS  |  Part $i of $total"; description = $desc; color = $col; footer = @{ text = "$ToolName  |  Suspect: $(if ($SuspectId) { $SuspectId } else { 'n/a' })  |  Mod: $(if ($ModId) { $ModId } else { 'n/a' })" } }
        [void](Send-DiscordPayload @{ username = $ToolName; allowed_mentions = @{ parse = @() }; embeds = @($emb) })
        Start-Sleep -Milliseconds 700
    }
    return $true
}
function Add-Pass([string]$Text) { $Script:Passed.Add($Text) }

